{
  "name": "vel-extension-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm test && npm run build",
    "dev": "vite --host 127.0.0.1",
    "preview": "node scripts/serve.mjs",
