    "three-custom-shader-material": "6.4.0",
    "three-mesh-bvh": "0.9.16",
    "three-nebula": "13.3.0",
    "three-subdivide": "1.1.5",
    "three.quarks": "0.17.1",
    "tone": "15.1.22",
    "troika-three-text": "0.52.5",
    "vite": "8.3.4",
    "wavesurfer.js": "8.0.2",
