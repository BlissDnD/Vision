    "@gltf-transform/functions": "4.5.1",
    "@jaames/iro": "5.5.2",
    "@melloware/coloris": "0.25.0",
    "@pmndrs/vanilla": "1.25.0",
    "@tweenjs/tween.js": "25.0.0",
    "bezier-easing": "3.2.0",
    "camera-controls": "3.1.2",
    "cannon-es": "0.20.0",
    "chroma-js": "3.2.0",
    "culori": "4.0.2",
    "d3-delaunay": "6.0.4",
    "earcut": "3.2.4",
    "esbuild": "0.28.2",
    "fit-curve": "0.2.0",
    "mediabunny": "1.61.6",
    "meshline": "3.3.1",
    "meshoptimizer": "1.3.0",
    "meyda": "5.6.3",
