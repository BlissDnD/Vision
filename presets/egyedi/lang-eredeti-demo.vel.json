oothstep(1.0,variationH*0.5,orig.y);\n  flame=pow(clamp(flame,0.0,1.0),3.0);\n  flame/=max(smoothstep(1.1,-0.1,orig.y),0.0001);\n  vec4 col=mix(vec4(1.0,1.0,0.0,0.0),vec4(1.0,1.0,0.6,0.0),flame);\n  col=mix(vec4(1.0,0.0,0.0,0.0),col,smoothstep(0.0,1.6,flame));\n  vec4 bluecolor=mix(vec4(0.0,0.0,1.0,0.0),col,0.95);\n  col=mix(col,bluecolor,blueflame);\n  col*=flame;col.a=flame;\n  float centerL=1.0-length(centerUV+vec2(0.0,0.1))/0.5;\n  vec4 halo=(vec4(0.8,0.3,0.3,0.0)*flameNoise(vec2(time*0.035))*centerL+0.02)*p_glow;\n  vec4 finalCol=mix(halo,col,col.a);\n  finalCol*=mix(flameRand(uv)+flameRand(uv*0.45),1.0,0.9);\n  return clamp(finalCol,0.0,1.0);\n}","asset":"flame-noise"}],"bg":"#000000","size":"1920x1080","look":{"preset":"Nyers","tone":0,"fps":0,"p":{"exposure":{"v":0,"a":0,"f":0.2,"w":0},"bloom":{"v":0,"a":0,"f":0.2,"w":0},"radius":{"v":0.6,"a":0,"f":0.2,"w":0},"thresh":{"v":0.8,"a":0,"f":0.2,"w":0},"hal":{"v":0,"a":0,"f":0.2,"w":0},"grain":{"v":0,"a":0,"f":0.2,"w":0},"vig":{"v":0,"a":0,"f":0.2,"w":0},"chroma":{"v":0,"a":0,"f":0.2,"w":0},"contrast":{"v":1,"a":0,"f":0.2,"w":0},"sat":{"v":1,"a":0,"f":0.2,"w":0},"temp":{"v":0,"a":0,"f":0.2,"w":0},"fade":{"v":0,"a":0,"f":0.2,"w":0},"sharpen":{"v":0,"a":0,"f":0.2,"w":0}}},"light":{"on":true,"p":{"az":{"v":-39.81,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"el":{"v":45.58,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"soft":{"v":0.5,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"size":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"warm":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"pow":{"v":1,"a":0,"f":0.2,"w":0,"s":"","sa":0.5}}},"cam":{"id":"__cam","name":"Kamera","type":"cam","vis":true,"on":false,"n":{"x":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"y":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"zoom":{"v":1,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"f":{"v":2.5,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"focus":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"ap":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa":0.5},"roll":{"v":0,"a":0,"f":0.2,"w":0,"s":"","sa"