+// Orphan Kapcsolat (both ends missing) is dropped on load; a live one survives.
+(()=>{const bad=[],info={};
+  const j=JSON.parse(projectJSON());
+  const a=makeLayer('shape'),b=makeLayer('shape');j.state.layers=[a,b];
+  j.state.links=[{id:'k1',on:true,from:{id:a.id,g:'n',k:'x'},to:{id:b.id,g:'n',k:'s'}},{id:'k2',on:true,from:{id:'ZZ',g:'n',k:'x'},to:{id:'YY',g:'n',k:'s'}}];
+  loadProject(JSON.parse(JSON.stringify(j)));const ids=st.links.map(l=>l.id);info.ids=ids;
+  if(!ids.includes('k1'))bad.push('live link dropped');if(ids.includes('k2'))bad.push('orphan link kept');
+  st.layers=[];st.links=[];commit();
+  return {bad,info};})()
